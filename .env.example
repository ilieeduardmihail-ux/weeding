# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public API key: the new publishable key (sb_publishable_...) or the legacy anon JWT (eyJ...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy variable name, still read when the publishable key above is empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for `npm run create-admin`. Bypasses RLS: keep it local, never prefix it
# with NEXT_PUBLIC_ and never add it to Vercel.
# SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to hash IPs for rate limiting. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RATE_LIMIT_SALT=

# Bearer token that Vercel sends to /api/cron/cleanup (vercel.json). Required in
# production; local `npm run dev` runs the cleanup without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CRON_SECRET=

# Canonical site URL, used by metadata, the calendar UID and the .ics description.
# Local: http://localhost:3000. Production: https://wedding-ro.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The platform owner's mailbox, used to send invoices with the PDF attached.
# GMAIL_APP_PASSWORD is a 16-character app password (Google Account → Security →
# App passwords), never the account password. Leave both empty to keep sending
# invoices by hand.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# Only for `npm run capture-previews`: the account that signs in to the demo
# wedding's panel so the marketing screenshots show the real product.
# The password is the one printed by `npm run seed-demo -- --reset`.
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_PASSWORD=

